import { ThymePalette, ThymeSpace, ThymeType, ThymeRadius } from "design/tokens.slint";
import { ThymeTextField } from "design/text-field.slint";
import { ThymeStatusChip, ThymeChipTone } from "design/status-chip.slint";
import { ThymeButton, ThymeButtonKind } from "design/button.slint";
import { PatientResultRow, PatientRow } from "patient-result-row.slint";
import { SuggestionRow, ThymeSuggestionCard } from "suggestion-row.slint";
export { PatientRow } from "patient-result-row.slint";

export struct HistoryEntryRow {
    line: string,
    meta: string,
}

// OctImageRow — a UI-only projection of one OCT scan on file
// (transport type: `packets::device::OctImageRecord`). Pre-formatted in
// Rust (`services::device_service::to_oct_image_rows`), same
// "format in Rust, render in Slint" split `HistoryEntryRow` uses.
// There's no inline preview here — see `OctImageCard`'s doc comment.
export struct OctImageRow {
    image-id: string,
    eye: string,
    dimensions: string,
    acquired: string,
}

export struct PatientFileData {
    patient-id: string,
    legal-name: string,
    preferred-name: string,
    detail-line: string,
    clinical-notes: [HistoryEntryRow],
    diagnoses: [HistoryEntryRow],
    follow-ups: [HistoryEntryRow],
    allergies: [HistoryEntryRow],
    medications: [HistoryEntryRow],
    lab-orders: [HistoryEntryRow],
    referrals: [HistoryEntryRow],
    refractions: [HistoryEntryRow],
    // Device-originated data (`server::dicom`) — populated separately
    // from everything above, via `DevicePatientItemsRequest`/`Response`
    // rather than `PatientFileRequest`/`Response`, since it comes from
    // its own staging tables (`device_studies`/`oct_images`/
    // `device_suggested_actions`) rather than the chart-history tables
    // the fields above are drawn from. See `controllers::doctor::listen_device`.
    oct-images: [OctImageRow],
    // Always `status == "pending"` — see
    // `services::device_service::to_device_suggestion_rows`.
    pending-device-suggestions: [SuggestionRow],
}

component HistoryEntryCard inherits Rectangle {
    in property <HistoryEntryRow> entry: { line: "", meta: "" };

    background: ThymePalette.surface-muted;
    border-radius: ThymeRadius.sm;

    VerticalLayout {
        padding: ThymeSpace.sm;
        spacing: 2px;

        Text {
            text: root.entry.line;
            font-size: ThymeType.size-sm;
            color: ThymePalette.text-primary;
            wrap: word-wrap;
        }

        if root.entry.meta != "": Text {
            text: root.entry.meta;
            font-size: ThymeType.size-xs;
            color: ThymePalette.text-secondary;
        }
    }
}

component HistorySection inherits Rectangle {
    in property <string> title;
    in property <[HistoryEntryRow]> entries: [];

    background: transparent;

    VerticalLayout {
        spacing: ThymeSpace.sm;

        Text {
            text: root.title + " (" + root.entries.length + ")";
            font-size: ThymeType.size-sm;
            font-weight: 700;
            color: ThymePalette.text-primary;
        }

        if root.entries.length == 0: Text {
            text: "None on file.";
            font-size: ThymeType.size-xs;
            color: ThymePalette.text-secondary;
        }

        if root.entries.length > 0: VerticalLayout {
            spacing: ThymeSpace.xs;

            for entry in root.entries: HistoryEntryCard {
                entry: entry;
            }
        }
    }
}

// OctImageCard — one OCT scan on file. No inline preview: this client
// has no raw-pixel-to-image decoding pipeline yet (see
// `packets::device::OctImageDataResponse`'s doc comment on why the
// bytes are native/uncompressed, not a displayable format already),
// so "Save" fetches the image's bytes and writes them to disk
// (`services::device_service::save_oct_image`) for a clinician to open
// in an external DICOM/image viewer, rather than rendering it here.
component OctImageCard inherits Rectangle {
    in property <OctImageRow> image: { image-id: "", eye: "", dimensions: "", acquired: "" };
    callback save-clicked();

    background: ThymePalette.surface-muted;
    border-radius: ThymeRadius.sm;

    HorizontalLayout {
        padding: ThymeSpace.sm;
        spacing: ThymeSpace.sm;
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.image.eye;
                font-size: ThymeType.size-sm;
                color: ThymePalette.text-primary;
            }

            Text {
                text: root.image.dimensions + " • " + root.image.acquired;
                font-size: ThymeType.size-xs;
                color: ThymePalette.text-secondary;
            }
        }

        ThymeButton {
            text: "Save";
            kind: ThymeButtonKind.secondary;
            height: 30px;
            clicked => { root.save-clicked(); }
        }
    }
}

component OctImageSection inherits Rectangle {
    in property <[OctImageRow]> images: [];
    callback save-requested(string);

    background: transparent;

    VerticalLayout {
        spacing: ThymeSpace.sm;

        Text {
            text: "Imaging (OCT) (" + root.images.length + ")";
            font-size: ThymeType.size-sm;
            font-weight: 700;
            color: ThymePalette.text-primary;
        }

        if root.images.length == 0: Text {
            text: "None on file.";
            font-size: ThymeType.size-xs;
            color: ThymePalette.text-secondary;
        }

        if root.images.length > 0: VerticalLayout {
            spacing: ThymeSpace.xs;

            for image in root.images: OctImageCard {
                image: image;
                save-clicked => { root.save-requested(image.image-id); }
            }
        }
    }
}

export component PatientFileCard inherits VerticalLayout {
    in property <PatientFileData> file: {
        patient-id: "", legal-name: "", preferred-name: "", detail-line: "",
        clinical-notes: [], diagnoses: [], follow-ups: [], allergies: [],
        medications: [], lab-orders: [], referrals: [], refractions: [], oct-images: [], pending-device-suggestions: [],
    };
    // Status of the most recently requested "Save" (empty when nothing's
    // in flight or nothing's been saved yet this session) — see
    // `controllers::doctor::listen_device`.
    in property <string> oct-status-text: "";
    // Feedback for the device-suggestions section specifically —
    // failed apply/reject, or a device-items fetch that failed
    // outright — kept separate from `oct-status-text` so an image-save
    // outcome and a suggestion-review outcome never overwrite each
    // other.
    in property <string> device-status-text: "";
    callback save-oct-image(string);
    callback accept-device-suggestion(string);
    callback reject-device-suggestion(string);

    spacing: ThymeSpace.lg;

    VerticalLayout {
        spacing: ThymeSpace.xs;

        Text {
            text: root.file.preferred-name != "" ? root.file.preferred-name : root.file.legal-name;
            font-size: ThymeType.size-lg;
            font-weight: 700;
            color: ThymePalette.text-primary;
        }

        if root.file.preferred-name != "" && root.file.preferred-name != root.file.legal-name: Text {
            text: "Legal name: " + root.file.legal-name;
            font-size: ThymeType.size-xs;
            color: ThymePalette.text-secondary;
        }

        Text {
            text: root.file.detail-line;
            font-size: ThymeType.size-sm;
            color: ThymePalette.text-secondary;
        }
    }

    if root.file.pending-device-suggestions.length > 0 || root.device-status-text != "": VerticalLayout {
        spacing: ThymeSpace.sm;

        if root.file.pending-device-suggestions.length > 0: Text {
            text: "Device readings awaiting review (" + root.file.pending-device-suggestions.length + ")";
            font-size: ThymeType.size-sm;
            font-weight: 700;
            color: ThymePalette.accent;
        }

        for suggestion in root.file.pending-device-suggestions: ThymeSuggestionCard {
            suggestion: suggestion;
            accept-clicked => { root.accept-device-suggestion(suggestion.suggestion-id); }
            reject-clicked => { root.reject-device-suggestion(suggestion.suggestion-id); }
        }

        if root.device-status-text != "": Text {
            text: root.device-status-text;
            font-size: ThymeType.size-xs;
            color: ThymePalette.text-secondary;
            wrap: word-wrap;
        }
    }

    OctImageSection {
        images: root.file.oct-images;
        save-requested(image-id) => { root.save-oct-image(image-id); }
    }

    if root.oct-status-text != "": Text {
        text: root.oct-status-text;
        font-size: ThymeType.size-xs;
        color: ThymePalette.text-secondary;
        wrap: word-wrap;
    }

    HistorySection {
        title: "Allergies";
        entries: root.file.allergies;
    }

    HistorySection {
        title: "Medications";
        entries: root.file.medications;
    }

    HistorySection {
        title: "Diagnoses";
        entries: root.file.diagnoses;
    }

    HistorySection {
        title: "Refractions";
        entries: root.file.refractions;
    }

    HistorySection {
        title: "Clinical notes";
        entries: root.file.clinical-notes;
    }

    HistorySection {
        title: "Follow-ups";
        entries: root.file.follow-ups;
    }

    HistorySection {
        title: "Lab orders";
        entries: root.file.lab-orders;
    }

    HistorySection {
        title: "Referrals";
        entries: root.file.referrals;
    }
}

export component PatientFileView inherits Rectangle {
    in-out property <string> search-query: "";
    in property <[PatientRow]> results: [];
    in property <bool> searching: false;
    in property <string> error-text: "";
    in property <string> selected-patient-id: "";

    in property <bool> file-loading: false;
    in property <string> file-error-text: "";
    in property <bool> has-file: false;
    in property <PatientFileData> file: {
        patient-id: "", legal-name: "", preferred-name: "", detail-line: "",
        clinical-notes: [], diagnoses: [], follow-ups: [], allergies: [],
        medications: [], lab-orders: [], referrals: [], refractions: [], oct-images: [], pending-device-suggestions: [],
    };
    in property <string> oct-status-text: "";
    in property <string> device-status-text: "";

    callback search-edited(string);
    callback patient-selected(string);
    callback save-oct-image(string);
    callback accept-device-suggestion(string);
    callback reject-device-suggestion(string);

    background: ThymePalette.background;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: ThymeSpace.xl;
        spacing: ThymeSpace.lg;

        VerticalLayout {
            width: 340px;
            spacing: ThymeSpace.md;

            HorizontalLayout {
                spacing: ThymeSpace.md;

                ThymeTextField {
                    horizontal-stretch: 1;
                    placeholder: "Search by name, MRN, phone, or date of birth";
                    text <=> root.search-query;
                    edited => { root.search-edited(root.search-query); }
                }

                if root.searching: ThymeStatusChip {
                    text: "Searching…";
                    tone: ThymeChipTone.info;
                }
            }

            if root.error-text != "": ThymeStatusChip {
                text: root.error-text;
                tone: ThymeChipTone.danger;
            }

            if !root.searching && root.results.length == 0 && root.error-text == "" && root.search-query == "": Text {
                text: "No patients on file yet.";
                color: ThymePalette.text-secondary;
                font-size: ThymeType.size-sm;
                wrap: word-wrap;
            }

            if root.search-query != "" && !root.searching && root.results.length == 0 && root.error-text == "": Text {
                text: "No patients found for \"" + root.search-query + "\".";
                color: ThymePalette.text-secondary;
                font-size: ThymeType.size-sm;
                wrap: word-wrap;
            }

            if root.results.length > 0: Flickable {
                vertical-stretch: 1;
                min-height: 0px;

                VerticalLayout {
                    spacing: ThymeSpace.sm;

                    for row in root.results: PatientResultRow {
                        patient: row;
                        selected: row.patient-id == root.selected-patient-id;
                        selected-changed => {
                            root.patient-selected(row.patient-id == root.selected-patient-id ? "" : row.patient-id);
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: ThymePalette.surface;
            border-radius: ThymeRadius.md;
            border-width: 1px;
            border-color: ThymePalette.border;

            if root.selected-patient-id == "": VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;

                Text {
                    text: "Select a patient to open their file.";
                    horizontal-alignment: center;
                    color: ThymePalette.text-secondary;
                    font-size: ThymeType.size-md;
                }
            }

            if root.selected-patient-id != "" && root.file-loading: VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;

                Text {
                    text: "Loading patient file…";
                    horizontal-alignment: center;
                    color: ThymePalette.text-secondary;
                    font-size: ThymeType.size-md;
                }
            }

            if root.selected-patient-id != "" && !root.file-loading && root.file-error-text != "": VerticalLayout {
                width: 100%;
                height: 100%;
                padding: ThymeSpace.xl;
                alignment: center;

                ThymeStatusChip {
                    text: root.file-error-text;
                    tone: ThymeChipTone.danger;
                }
            }

            if root.selected-patient-id != "" && !root.file-loading && root.file-error-text == "" && root.has-file: Flickable {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding: ThymeSpace.xl;

                    PatientFileCard {
                        file: root.file;
                        oct-status-text: root.oct-status-text;
                        device-status-text: root.device-status-text;
                        save-oct-image(image-id) => { root.save-oct-image(image-id); }
                        accept-device-suggestion(suggestion-id) => { root.accept-device-suggestion(suggestion-id); }
                        reject-device-suggestion(suggestion-id) => { root.reject-device-suggestion(suggestion-id); }
                    }
                }
            }
        }
    }
}