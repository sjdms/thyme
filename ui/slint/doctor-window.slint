import {
    ThymePalette,
    ThymeSpace,
    ThymeType,
    ThymeRadius,
} from "design/tokens.slint";
import { ThymeHeader } from "design/header.slint";
import { ThymeSidebar, ThymeSidebarItem } from "design/sidebar.slint";
import { ThymeStatusChip, ThymeChipTone } from "design/status-chip.slint";
import { ThymeButton, ThymeButtonKind } from "design/button.slint";
import { ThymeSettingsPanel } from "design/settings-panel.slint";
import { ThymeConfirmDialog } from "design/confirm-dialog.slint";
import { QueueEntryRow, QueueEntryCard } from "queue-entry-row.slint";
import { SuggestionRow, ThymeSuggestionCard } from "suggestion-row.slint";
import {
    PatientFileView,
    PatientRow,
    PatientFileData,
    PatientFileCard,
} from "patient-file-view.slint";
export { QueueEntryRow }from "queue-entry-row.slint";
export { SuggestionRow }from "suggestion-row.slint";
export {
    PatientRow,
    HistoryEntryRow,
    PatientFileData,
}from "patient-file-view.slint";

export component DoctorWindow inherits Window {
    title: "Thyme — Doctor";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;
    background: ThymePalette.background;

    in property <string> user-display-name: "";
    in property <string> connection-status-text: "Connected";
    in property <ThymeChipTone> connection-status-tone: ThymeChipTone.success;

    in-out property <int> selected-nav-index: 0;

    in property <[QueueEntryRow]> queue-entries: [];
    in property <string> queue-error-text: "";
    callback queue-advance-requested(string, string);

    in property <bool> recording-active: false;
    in property <string> recording-error-text: "";

    in property <bool> has-patient-with-doctor: false;
    in property <string> current-patient-id: "";
    in property <string> current-patient-name: "";
    // Queue id (not patient id) of whoever is currently `with_doctor`,
    // if anyone — needed alongside `current-patient-id` so "End
    // encounter" can target the right `patient_queue` row via
    // `queue-advance-requested`.
    in property <string> current-queue-id: "";
    // Queue id of the most-recently-registered `"waiting"` entry, or
    // "" if no one is waiting — `queue-entries` is oldest-first (see
    // `db::queue_repository::QueueRepository::list_active`), so this
    // is computed Rust-side rather than re-deriving "last waiting" here.
    in property <string> latest-waiting-queue-id: "";

    // Set when starting a new encounter (either "Begin encounter" or a
    // row's "Start visit") would require ending the one already in
    // progress — see `next-status`/`action-label-for` above and the
    // "only one patient with the doctor at once" server-side check
    // this warns ahead of (`server::server`, `PatientQueueAdvanceRequest`
    // handling).
    property <bool> show-discard-confirm: false;
    property <string> pending-start-queue-id: "";

    function request-encounter-start(queue-id: string) {
        if (root.has-patient-with-doctor && queue-id != root.current-queue-id) {
            root.pending-start-queue-id = queue-id;
            root.show-discard-confirm = true;
        } else {
            root.queue-advance-requested(queue-id, "with_doctor");
        }
    }

    in property <bool> current-patient-file-loading: false;
    in property <string> current-patient-file-error-text: "";
    in property <bool> current-patient-has-file: false;
    in property <PatientFileData> current-patient-file: {
        patient-id: "",
        legal-name: "",
        preferred-name: "",
        detail-line: "",
        clinical-notes: [],
        diagnoses: [],
        follow-ups: [],
        allergies: [],
        medications: [],
        lab-orders: [],
        referrals: [],
        refractions: [],
        oct-images: [],
        pending-device-suggestions: [],
    };

    // Device-originated (DICOM) UI plumbing shared by both
    // `PatientFileCard`/`PatientFileView` instantiations below (the
    // dashboard's "in the room now" panel and the "Patients" tab) —
    // see `controllers::doctor::listen_device`. One shared
    // `oct-status-text`/`device-status-text` pair is a deliberate
    // simplification: only one image save or suggestion review is ever
    // realistically in flight at a time, so it isn't worth threading a
    // separate status per panel.
    in property <string> oct-status-text: "";
    in property <string> device-status-text: "";
    callback save-oct-image(string);
    callback device-suggestion-accepted(string);
    callback device-suggestion-rejected(string);

    in property <string> transcription-state: "idle";
    in property <string> last-transcript: "";
    in property <string> transcript-error-text: "";
    callback transcription-panel-dismissed();

    in property <bool> ai-processing: false;
    in property <string> ai-error-text: "";
    in property <string> ai-transcription-id: "";
    in property <[SuggestionRow]> ai-suggestions: [];
    callback suggestion-accepted(string);
    callback suggestion-rejected(string);
    callback approve-all-requested();

    in property <string> recording-clarification-id: "";
    callback clarification-answer-submitted(string, string);
    callback clarification-voice-toggled(string);

    property <int> spinner-tick: 0;
    property <[string]> spinner-frames: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];

    spinner-timer := Timer {
        interval: 90ms;
        running: root.transcription-state == "transcribing" || root.ai-processing;
        triggered => {
            root.spinner-tick = root.spinner-tick + 1 >= root.spinner-frames.length ? 0 : root.spinner-tick + 1;
        }
    }

    in-out property <bool> show-settings: false;
    in-out property <float> settings-mic-gain: 1.0;
    in-out property <bool> settings-confirm-sign-out: false;
    in property <string> settings-error-text: "";
    callback settings-requested();
    callback settings-saved();
    callback settings-cancelled();

    in-out property <bool> show-sign-out-confirm: false;
    callback sign-out-confirmed();
    callback sign-out-cancelled();

    callback shortcut-pressed();
    callback shortcut-released();
    callback sign-out();

    function next-status(status: string) -> string {
        if (status == "waiting") {
            return "with_doctor";
        }
        if (status == "with_doctor") {
            return "done";
        }
        return "";
    }

    function action-label-for(status: string) -> string {
        if (status == "waiting") {
            return "Start visit";
        }
        if (status == "with_doctor") {
            return "Complete";
        }
        return "";
    }

    in property <int> waiting-count: 0;

    in-out property <string> patients-search-query: "";
    in property <[PatientRow]> patients-search-results: [];
    in property <bool> patients-search-busy: false;
    in property <string> patients-search-error-text: "";
    in property <string> patients-selected-patient-id: "";
    in property <bool> patients-file-loading: false;
    in property <string> patients-file-error-text: "";
    in property <bool> patients-has-file: false;
    in property <PatientFileData> patients-file: {
        patient-id: "",
        legal-name: "",
        preferred-name: "",
        detail-line: "",
        clinical-notes: [],
        diagnoses: [],
        follow-ups: [],
        allergies: [],
        medications: [],
        lab-orders: [],
        referrals: [],
        refractions: [],
        oct-images: [],
        pending-device-suggestions: [],
    };
    callback patients-search-edited(string);
    callback patients-patient-selected(string);

    scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if ((event.text == "r" || event.text == "R") && event.modifiers.control) {
                root.shortcut-pressed();
                return EventResult.accept;
            } else {
                return EventResult.reject;
            }
        }
        key-released(event) => {
            if (event.text == "r" || event.text == "R") {
                root.shortcut-released();
                return EventResult.accept;
            } else {
                return EventResult.reject;
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;

            ThymeHeader {
                user-display-name: root.user-display-name;
                connection-status-text: root.connection-status-text;
                connection-status-tone: root.connection-status-tone;
                section-label: "Doctor";
                sign-out => { root.sign-out(); }
                settings-requested => { root.settings-requested(); }
            }

            HorizontalLayout {
                height: 95%;

                ThymeSidebar {
                    items: [
                        { label: "Dashboard", enabled: true },
                        { label: "Patients", enabled: true },
                        { label: "Encounters", enabled: false },
                    ];
                    selected-index: root.selected-nav-index;
                    item-selected(index) => { root.selected-nav-index = index; }
                }

                if root.selected-nav-index == 0: Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: ThymePalette.background;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding: ThymeSpace.xl;
                        spacing: ThymeSpace.xl;

                        VerticalLayout {
                            width: 400px;
                            spacing: ThymeSpace.lg;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Today";
                                    font-size: ThymeType.size-lg;
                                    font-weight: 700;
                                    color: ThymePalette.text-primary;
                                }

                                ThymeStatusChip {
                                    text: root.waiting-count + " waiting";
                                    tone: root.waiting-count > 0 ? ThymeChipTone.warning : ThymeChipTone.neutral;
                                }
                            }

                            if !root.recording-active: Text {
                                text: root.has-patient-with-doctor
                                    ? "Hold Ctrl+R anywhere in this window to record a voice note for " + root.current-patient-name + ". Release R to stop and transcribe."
                                    : "Start a patient's visit below (\"Start visit\") before recording a voice note — recording needs a patient in the room to attach the note to.";
                                font-size: ThymeType.size-xs;
                                color: root.has-patient-with-doctor ? ThymePalette.text-secondary : ThymePalette.warning;
                                wrap: word-wrap;
                            }

                            /*if root.recording-active || root.recording-error-text != "": Rectangle {
                                width: 100%;
                                height: 100%;

                                border-radius: ThymeRadius.lg;
                                background: ThymePalette.danger-surface;
                                border-width: 1px;
                                border-color: ThymePalette.danger;
                                drop-shadow-color: #00000022;
                                drop-shadow-blur: 12px;
                                drop-shadow-offset-y: 2px;

                                HorizontalLayout {
                                    padding: ThymeSpace.md;
                                    spacing: ThymeSpace.sm;

                                    if root.recording-active: Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        y: (parent.height - self.height) / 2;
                                        background: ThymePalette.danger;
                                    }

                                    Text {
                                        text: root.recording-active ? "Recording… release Ctrl+R to stop" : root.recording-error-text;
                                        font-size: ThymeType.size-sm;
                                        font-weight: 600;
                                        color: ThymePalette.danger;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }*/

                            if root.queue-error-text != "": ThymeStatusChip {
                                text: root.queue-error-text;
                                tone: ThymeChipTone.danger;
                            }

                            if root.queue-entries.length == 0: Text {
                                text: "No patients currently waiting.";
                                color: ThymePalette.text-secondary;
                                font-size: ThymeType.size-md;
                            }

                            if root.queue-entries.length > 0: Flickable {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: ThymeSpace.sm;

                                    for entry in root.queue-entries: QueueEntryCard {
                                        entry: entry;
                                        show-action: root.next-status(entry.status) != "";
                                        action-label: root.action-label-for(entry.status);
                                        action-clicked => {
                                            if (root.next-status(entry.status) == "with_doctor") {
                                                root.request-encounter-start(entry.queue-id);
                                            } else {
                                                root.queue-advance-requested(entry.queue-id, root.next-status(entry.status));
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            background: ThymePalette.surface;
                            border-radius: ThymeRadius.md;
                            border-width: 1px;
                            border-color: ThymePalette.border;

                            if !root.has-patient-with-doctor: VerticalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: center;

                                Text {
                                    text: "No patient in the room yet. Start a visit to see their chart here.";
                                    horizontal-alignment: center;
                                    color: ThymePalette.text-secondary;
                                    font-size: ThymeType.size-md;
                                    wrap: word-wrap;
                                }
                            }

                            if root.has-patient-with-doctor && root.current-patient-file-loading: VerticalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: center;

                                Text {
                                    text: "Loading " + root.current-patient-name + "'s chart…";
                                    horizontal-alignment: center;
                                    color: ThymePalette.text-secondary;
                                    font-size: ThymeType.size-md;
                                }
                            }

                            if root.has-patient-with-doctor && !root.current-patient-file-loading && root.current-patient-file-error-text != "": VerticalLayout {
                                width: 100%;
                                height: 100%;
                                padding: ThymeSpace.xl;
                                alignment: center;

                                ThymeStatusChip {
                                    text: root.current-patient-file-error-text;
                                    tone: ThymeChipTone.danger;
                                }
                            }

                            if root.has-patient-with-doctor && !root.current-patient-file-loading && root.current-patient-file-error-text == "" && root.current-patient-has-file: Flickable {
                                width: 100%;
                                height: 100%;

                                VerticalLayout {
                                    padding: ThymeSpace.xl;

                                    HorizontalLayout {
                                        alignment: space-between;

                                        Text {
                                            text: "In the room now";
                                            font-size: ThymeType.size-sm;
                                            font-weight: 700;
                                            color: ThymePalette.accent;
                                            vertical-alignment: center;
                                        }

                                        ThymeButton {
                                            text: "End encounter";
                                            kind: ThymeButtonKind.secondary;
                                            width: 140px;
                                            clicked => {
                                                root.queue-advance-requested(root.current-queue-id, "done");
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: ThymeSpace.sm;
                                    }

                                    PatientFileCard {
                                        file: root.current-patient-file;
                                        oct-status-text: root.oct-status-text;
                                        device-status-text: root.device-status-text;
                                        save-oct-image(image-id) => { root.save-oct-image(image-id); }
                                        accept-device-suggestion(id) => { root.device-suggestion-accepted(id); }
                                        reject-device-suggestion(id) => { root.device-suggestion-rejected(id); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.selected-nav-index == 1: PatientFileView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    search-query <=> root.patients-search-query;
                    results: root.patients-search-results;
                    searching: root.patients-search-busy;
                    error-text: root.patients-search-error-text;
                    selected-patient-id: root.patients-selected-patient-id;
                    file-loading: root.patients-file-loading;
                    file-error-text: root.patients-file-error-text;
                    has-file: root.patients-has-file;
                    file: root.patients-file;
                    oct-status-text: root.oct-status-text;
                    device-status-text: root.device-status-text;
                    save-oct-image(image-id) => { root.save-oct-image(image-id); }
                    accept-device-suggestion(id) => { root.device-suggestion-accepted(id); }
                    reject-device-suggestion(id) => { root.device-suggestion-rejected(id); }
                    search-edited(query) => { root.patients-search-edited(query); }
                    patient-selected(id) => { root.patients-patient-selected(id); }
                }
            }
        }

        if root.show-settings: Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;

            TouchArea { }

            settings-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.settings-cancelled();
                        return EventResult.accept;
                    } else {
                        return EventResult.reject;
                    }
                }

                settings-panel := ThymeSettingsPanel {
                    width: 420px;
                    x: ((parent.width - self.width) / 2);
                    y: ((parent.height - self.height) / 2);
                    mic-gain <=> root.settings-mic-gain;
                    confirm-before-sign-out <=> root.settings-confirm-sign-out;
                    show-mic-gain: true;
                    error-text: root.settings-error-text;
                    saved => { root.settings-saved(); }
                    cancelled => { root.settings-cancelled(); }
                }

                init => {
                    settings-scope.focus();
                }
            }
        }

        if root.show-discard-confirm: Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;

            TouchArea { }

            discard-confirm-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.show-discard-confirm = false;
                        root.pending-start-queue-id = "";
                        return EventResult.accept;
                    } else {
                        return EventResult.reject;
                    }
                }

                HorizontalLayout {
                    alignment: center;

                    VerticalLayout {
                        alignment: center;

                        ThymeConfirmDialog {
                            width: 360px;
                            title: "End the current encounter?";
                            message: root.current-patient-name + " is still with the doctor. Starting a new encounter will end their visit first.";
                            confirm-label: "End visit & continue";
                            cancel-label: "Cancel";
                            danger: true;
                            confirmed => {
                                root.show-discard-confirm = false;
                                root.queue-advance-requested(root.current-queue-id, "done");
                                root.queue-advance-requested(root.pending-start-queue-id, "with_doctor");
                                root.pending-start-queue-id = "";
                            }
                            cancelled => {
                                root.show-discard-confirm = false;
                                root.pending-start-queue-id = "";
                            }
                        }
                    }
                }

                init => {
                    discard-confirm-scope.focus();
                }
            }
        }

        if root.show-sign-out-confirm: Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;

            TouchArea { }

            confirm-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.sign-out-cancelled();
                        return EventResult.accept;
                    } else {
                        return EventResult.reject;
                    }
                }

                HorizontalLayout {
                    alignment: center;

                    VerticalLayout {
                        alignment: center;

                        ThymeConfirmDialog {
                            width: 360px;
                            title: "Sign out?";
                            message: "You'll need to sign in again to continue.";
                            confirm-label: "Sign out";
                            cancel-label: "Stay signed in";
                            danger: true;
                            confirmed => { root.sign-out-confirmed(); }
                            cancelled => { root.sign-out-cancelled(); }
                        }
                    }
                }

                init => {
                    confirm-scope.focus();
                }
            }
        }

        if root.recording-active || root.recording-error-text != "": Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            Rectangle {
                width: 320px;
                x: parent.width - self.width - ThymeSpace.xl;
                y: parent.height - self.height - ThymeSpace.xl;
                border-radius: ThymeRadius.lg;
                background: ThymePalette.danger-surface;
                border-width: 1px;
                border-color: ThymePalette.danger;
                drop-shadow-color: #00000022;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 2px;

                HorizontalLayout {
                    padding: ThymeSpace.md;
                    spacing: ThymeSpace.sm;

                    if root.recording-active: Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        y: (parent.height - self.height) / 2;
                        background: ThymePalette.danger;
                    }

                    Text {
                        text: root.recording-active ? "Recording… release Ctrl+R to stop" : root.recording-error-text;
                        font-size: ThymeType.size-sm;
                        font-weight: 600;
                        color: ThymePalette.danger;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.transcription-state != "idle": Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            Rectangle {
                width: 320px;
                height: 100%;
                x: parent.width - self.width;
                y: 0;
                background: ThymePalette.surface;
                border-width: 1px;
                border-color: ThymePalette.border;
                drop-shadow-color: #00000022;
                drop-shadow-blur: 20px;
                drop-shadow-offset-x: -2px;

                TouchArea { }

                VerticalLayout {
                    padding: ThymeSpace.xl;
                    spacing: ThymeSpace.lg;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "Voice note";
                            font-size: ThymeType.size-lg;
                            font-weight: 700;
                            color: ThymePalette.text-primary;
                            vertical-alignment: center;
                        }

                        ThymeButton {
                            text: "×";
                            kind: ThymeButtonKind.ghost;
                            width: 32px;
                            clicked => { root.transcription-panel-dismissed(); }
                        }
                    }

                    if root.transcription-state == "transcribing": VerticalLayout {
                        spacing: ThymeSpace.md;

                        Text {
                            text: root.spinner-frames[root.spinner-tick];
                            font-size: 32px;
                            color: ThymePalette.accent;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Transcribing…";
                            font-size: ThymeType.size-md;
                            color: ThymePalette.text-secondary;
                            horizontal-alignment: center;
                        }
                    }

                    if root.transcription-state == "done": Flickable {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: ThymeSpace.md;

                            ThymeStatusChip {
                                text: "Transcribed";
                                tone: ThymeChipTone.success;
                            }

                            Text {
                                text: root.last-transcript;
                                font-size: ThymeType.size-sm;
                                color: ThymePalette.text-primary;
                                wrap: word-wrap;
                            }

                            if root.ai-processing: HorizontalLayout {
                                spacing: ThymeSpace.sm;

                                Text {
                                    text: root.spinner-frames[root.spinner-tick];
                                    font-size: ThymeType.size-md;
                                    color: ThymePalette.accent;
                                }

                                Text {
                                    text: "Reviewing transcript for chart updates…";
                                    font-size: ThymeType.size-sm;
                                    color: ThymePalette.text-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            if root.ai-error-text != "": ThymeStatusChip {
                                text: root.ai-error-text;
                                tone: ThymeChipTone.danger;
                            }

                            if root.ai-suggestions.length > 0: VerticalLayout {
                                spacing: ThymeSpace.sm;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: "Suggested chart updates";
                                        font-size: ThymeType.size-sm;
                                        font-weight: 700;
                                        color: ThymePalette.text-primary;
                                        vertical-alignment: center;
                                    }

                                    ThymeButton {
                                        text: "Approve all";
                                        kind: ThymeButtonKind.secondary;
                                        height: 30px;
                                        clicked => { root.approve-all-requested(); }
                                    }
                                }

                                for suggestion in root.ai-suggestions: ThymeSuggestionCard {
                                    suggestion: suggestion;
                                    voice-answer-active: root.recording-clarification-id == suggestion.suggestion-id;
                                    accept-clicked => { root.suggestion-accepted(suggestion.suggestion-id); }
                                    reject-clicked => { root.suggestion-rejected(suggestion.suggestion-id); }
                                    answer-submitted(answer) => { root.clarification-answer-submitted(suggestion.suggestion-id, answer); }
                                    voice-answer-toggled => { root.clarification-voice-toggled(suggestion.suggestion-id); }
                                }
                            }
                        }
                    }

                    if root.transcription-state == "error": VerticalLayout {
                        spacing: ThymeSpace.md;

                        ThymeStatusChip {
                            text: "Transcription failed";
                            tone: ThymeChipTone.danger;
                        }

                        Text {
                            text: root.transcript-error-text;
                            font-size: ThymeType.size-sm;
                            color: ThymePalette.danger;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    changed show-settings => {
        if (!root.show-settings) {
            scope.focus();
        }
    }

    changed show-sign-out-confirm => {
        if (!root.show-sign-out-confirm) {
            scope.focus();
        }
    }

    init => {
        scope.focus();
    }
}
